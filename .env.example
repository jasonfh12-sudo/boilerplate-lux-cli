# =================================================================
# Environment Configuration - Next.js Boilerplate with Better Auth
# =================================================================

# IMPORTANT: When deployed to Lux platform, these are set at the
# container level automatically. You don't need to create a .env file.
#
# For local development, copy this to .env.local and fill in values.

# -----------------------------------------------------------------
# Organization (Lux Platform - Container Level)
# -----------------------------------------------------------------

# Organization ID from Clerk
# Used to construct org-specific Turso database URL
# Format: org_{random_id}
# Example: org_2abc123def456
#
# In production: Set at container level by Lux platform
# In development: Optional (can use TURSO_DATABASE_URL instead)
CLERK_ORG_ID=

# -----------------------------------------------------------------
# Database (Turso/LibSQL)
# -----------------------------------------------------------------

# Turso authentication token
# Single token works for all org databases
#
# In production: Set at container level by Lux platform
# In development: Get from: turso auth token
TURSO_AUTH_TOKEN=

# Explicit database URL (Development Only)
# Use this for local testing without CLERK_ORG_ID
#
# Get URL: turso db show your-db --url
# Example: libsql://your-db.turso.io
#
# NOTE: In production with CLERK_ORG_ID, this is automatically
# constructed as: libsql://{orgId}-lux-ai-labs.aws-us-west-2.turso.io
TURSO_DATABASE_URL=

# -----------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------

# Better Auth secret key (32+ characters)
# Used for signing tokens and sessions
#
# Generate: openssl rand -hex 32
# Or let setup script generate automatically
#
# In production: Set at container level
# In development: Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Application URL
# Used for OAuth callbacks and email links
#
# In production: https://your-domain.com
# In development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------
# OAuth Providers (Optional)
# -----------------------------------------------------------------

# Google OAuth
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------
# Storage & Infrastructure (Lux Platform - Container Level)
# -----------------------------------------------------------------

# These are set at container level by Lux platform
# Included here for reference

# Redis (Upstash)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Object Storage (Cloudflare R2)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_KV_API_TOKEN=

# AI Services
# ANTHROPIC_API_KEY=

# GitHub Integration
# GITHUB_PAT=

# Organization Directory
# ORG_DIR=/org

# -----------------------------------------------------------------
# Development Notes
# -----------------------------------------------------------------

# To run this locally with auth:
#
# 1. Create Turso database:
#    turso db create my-test-db
#
# 2. Get credentials:
#    turso db show my-test-db --url
#    turso auth token
#
# 3. Copy this file:
#    cp .env.example .env.local
#
# 4. Fill in values:
#    TURSO_DATABASE_URL=libsql://my-test-db.turso.io
#    TURSO_AUTH_TOKEN=your_token_here
#    BETTER_AUTH_SECRET=your_32_char_secret
#
# 5. Install & setup:
#    npm install  (runs setup script automatically)
#    npm run dev
#
# 6. Test authentication:
#    Visit http://localhost:3000/auth/signup

# -----------------------------------------------------------------
# Production Deployment (Lux Platform)
# -----------------------------------------------------------------

# When deployed via `lux interface init`:
#
# ✓ CLERK_ORG_ID - Auto-set from org context
# ✓ TURSO_AUTH_TOKEN - Auto-set from container config
# ✓ Database tables - Auto-created via postinstall hook
# ✓ Ready to use immediately
#
# No manual configuration needed!
